ARG MATCH_BASE=hexpm/elixir:1.19.5-erlang-28.3.1-ubuntu-noble-20260410
ARG FASTCHESS_REF=v1.8.0-alpha

FROM ${MATCH_BASE}

ARG FASTCHESS_REF

ENV MIX_ENV=prod \
    DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PATH=/usr/games:${PATH} \
    TZ=Etc/UTC \
    XLA_TARGET=cpu

RUN apt-get update -y && \
    apt-get install -y build-essential git ca-certificates make g++ stockfish python3 bash curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch ${FASTCHESS_REF} https://github.com/Disservin/fastchess.git /tmp/fastchess && \
    cd /tmp/fastchess && make -j"$(nproc)" && \
    install /tmp/fastchess/fastchess /usr/local/bin/fastchess && \
    rm -rf /tmp/fastchess

WORKDIR /app

RUN mix local.hex --force && \
    mix local.rebar --force

COPY mix.exs mix.lock ./

RUN mix deps.get --only $MIX_ENV
RUN cd deps/echecs && elixir scripts/generate_magic_cache.exs
RUN mix deps.compile

COPY . .

RUN mix compile

CMD ["fastchess", "-h"]
